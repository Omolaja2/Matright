@model List<Sale>
@{
    ViewData["Title"] = "Daily Summary";
    var targetDate = (DateTime)ViewBag.Date;
    var totalSales = Model.Sum(s => s.TotalAmount);
    var totalTax = Model.Sum(s => s.TaxAmount);
    var totalSub = Model.Sum(s => s.SubTotal);
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-calendar-day"></i> Daily Sales Summary</h1>
        <p>@targetDate.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="btn-group">
        <a asp-action="Index" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back to Sales</a>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon green"><i class="fas fa-shopping-bag"></i></div>
        <span class="stat-label">Total Sales</span>
        <span class="stat-value">@Model.Count</span>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fas fa-naira-sign"></i></div>
        <span class="stat-label">Revenue</span>
        <span class="stat-value">@CurrencyHelper.FormatCurrency(totalSales)</span>
    </div>
    <div class="stat-card">
        <div class="stat-icon yellow"><i class="fas fa-percent"></i></div>
        <span class="stat-label">Tax Collected</span>
        <span class="stat-value">@CurrencyHelper.FormatCurrency(totalTax)</span>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple"><i class="fas fa-chart-line"></i></div>
        <span class="stat-label">Avg. Sale</span>
        <span class="stat-value">@(Model.Count > 0 ? CurrencyHelper.FormatCurrency(totalSales / Model.Count) : CurrencyHelper.FormatCurrency(0))</span>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-list"></i> Sales for @targetDate.ToString("dd MMM yyyy")</h3>
    </div>
    <div class="card-body">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Time</th>
                        <th>Items</th>
                        <th>Sub Total</th>
                        <th>Tax</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Cashier</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <i class="fas fa-calendar-day"></i>
                                    <h3>No sales today</h3>
                                    <p>No transactions have been recorded for this date.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var sale in Model.OrderBy(s => s.SaleDate))
                        {
                            <tr>
                                <td><strong>@sale.InvoiceNumber</strong></td>
                                <td>@sale.SaleDate.ToString("hh:mm tt")</td>
                                <td>@sale.SaleItems.Count</td>
                                <td>@CurrencyHelper.FormatCurrency(sale.SubTotal)</td>
                                <td>@CurrencyHelper.FormatCurrency(sale.TaxAmount)</td>
                                <td><strong>@CurrencyHelper.FormatCurrency(sale.TotalAmount)</strong></td>
                                <td><span class="badge badge-@(sale.PaymentMethod == PaymentMethod.Cash ? "success" : sale.PaymentMethod == PaymentMethod.POS ? "info" : "warning")">@sale.PaymentMethod</span></td>
                                <td>@(sale.CashierName ?? "N/A")</td>
                            </tr>
                        }
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot>
                        <tr style="background:#fafafa;">
                            <td colspan="3" style="font-weight:700;padding:12px 16px;">Totals</td>
                            <td style="font-weight:700;padding:12px 16px;">@CurrencyHelper.FormatCurrency(totalSub)</td>
                            <td style="font-weight:700;padding:12px 16px;">@CurrencyHelper.FormatCurrency(totalTax)</td>
                            <td style="font-weight:700;padding:12px 16px;">@CurrencyHelper.FormatCurrency(totalSales)</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
