@model SalesReportViewModel
@{
    ViewData["Title"] = "Sales History";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-receipt"></i> Sales History</h1>
        <p>View and filter all transactions</p>
    </div>
    <div class="btn-group">
        <a asp-action="DailySummary" class="btn btn-outline"><i class="fas fa-calendar-day"></i> Daily Summary</a>
        <a asp-action="POS" class="btn btn-accent"><i class="fas fa-cash-register"></i> New Sale</a>
    </div>
</div>

<form method="get" asp-action="Index">
    <div class="filters-bar">
        <div class="form-group" style="margin:0">
            <label style="font-size:12px;color:var(--text-muted);">Start Date</label>
            <input type="date" name="startDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group" style="margin:0">
            <label style="font-size:12px;color:var(--text-muted);">End Date</label>
            <input type="date" name="endDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group" style="margin:0">
            <label style="font-size:12px;color:var(--text-muted);">Payment Method</label>
            <select name="paymentMethod" class="form-control">
                <option value="">All Methods</option>
                @foreach (PaymentMethod m in Enum.GetValues<PaymentMethod>())
                {
                    <option value="@((int)m)" selected="@(Model.PaymentMethodFilter == m)">@m</option>
                }
            </select>
        </div>
        <div class="form-group" style="margin:0">
            <button type="submit" class="btn btn-primary" style="margin-top:18px"><i class="fas fa-filter"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline" style="margin-top:18px">Clear</a>
        </div>
    </div>
</form>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon green"><i class="fas fa-naira-sign"></i></div>
        <span class="stat-label">Total Sales</span>
        <span class="stat-value">@CurrencyHelper.FormatCurrency(Model.TotalSales)</span>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fas fa-shopping-bag"></i></div>
        <span class="stat-label">Transactions</span>
        <span class="stat-value">@Model.TotalTransactions</span>
    </div>
    <div class="stat-card">
        <div class="stat-icon yellow"><i class="fas fa-chart-line"></i></div>
        <span class="stat-label">Avg. Transaction</span>
        <span class="stat-value">@CurrencyHelper.FormatCurrency(Model.AverageTransactionValue)</span>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple"><i class="fas fa-percent"></i></div>
        <span class="stat-label">Total Tax</span>
        <span class="stat-value">@CurrencyHelper.FormatCurrency(Model.TotalTax)</span>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-list"></i> Transactions</h3>
        <a asp-action="Export" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-paymentMethod="@Model.PaymentMethodFilter" class="btn btn-sm btn-outline"><i class="fas fa-file-csv"></i> Export CSV</a>
    </div>
    <div class="card-body">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Sub Total</th>
                        <th>Tax</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Sales.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <i class="fas fa-receipt"></i>
                                    <h3>No sales found</h3>
                                    <p>No transactions match your filters.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var sale in Model.Sales)
                        {
                            <tr>
                                <td><strong>@sale.InvoiceNumber</strong></td>
                                <td>@CurrencyHelper.FormatDateTime(sale.SaleDate)</td>
                                <td>@sale.ItemCount</td>
                                <td>@CurrencyHelper.FormatCurrency(sale.SubTotal)</td>
                                <td>@CurrencyHelper.FormatCurrency(sale.TaxAmount)</td>
                                <td><strong>@CurrencyHelper.FormatCurrency(sale.TotalAmount)</strong></td>
                                <td><span class="badge badge-@(sale.PaymentMethod == PaymentMethod.Cash ? "success" : sale.PaymentMethod == PaymentMethod.POS ? "info" : "warning")">@sale.PaymentMethod</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@sale.SaleId" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i> View</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Pagination", new PharMarket.Helpers.PaginationInfo
{
    CurrentPage = Model.CurrentPage,
    TotalPages = Model.TotalPages,
    Action = "Index",
    Controller = "Sales",
    RouteValues = new Dictionary<string, string?>
    {
        ["startDate"] = Model.StartDate?.ToString("yyyy-MM-dd"),
        ["endDate"] = Model.EndDate?.ToString("yyyy-MM-dd"),
        ["paymentMethod"] = Model.PaymentMethodFilter?.ToString()
    }
})
