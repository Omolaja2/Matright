<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - PharMarket</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
        .user-menu { display: flex; align-items: center; gap: 8px; font-size: 13px; }
        .user-name { font-weight: 600; }
        .user-role { background: #f3f4f6; padding: 2px 8px; border-radius: 12px; font-size: 11px; color: #666; }
        .notification-dropdown { position: relative; }
        .notification-bell { position: relative; cursor: pointer; }
        .notification-badge { position: absolute; top: -2px; right: -2px; background: var(--danger); color: #fff; font-size: 9px; font-weight: 700; min-width: 16px; height: 16px; border-radius: 8px; display: flex; align-items: center; justify-content: center; line-height: 1; }
        .notification-badge:empty { display: none; }
        .notification-panel { display: none; position: absolute; top: 100%; right: 0; width: 320px; max-height: 400px; overflow-y: auto; background: #fff; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,.12); z-index: 200; margin-top: 8px; }
        .notification-panel.open { display: block; }
        .notification-panel-header { padding: 14px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
        .notification-panel-header h4 { font-size: 14px; font-weight: 700; }
        .notification-panel-header button { font-size: 12px; color: var(--info); background: none; border: none; cursor: pointer; font-weight: 600; }
        .notification-item { padding: 12px 16px; border-bottom: 1px solid #f3f4f6; cursor: pointer; transition: background 0.15s; }
        .notification-item:hover { background: #f9f9fb; }
        .notification-item:last-child { border-bottom: none; }
        .notification-item .title { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
        .notification-item .message { font-size: 12px; color: var(--text-muted); line-height: 1.4; }
        .notification-item .time { font-size: 11px; color: var(--text-dim); margin-top: 4px; }
        .notification-item.warning .title { color: var(--warning); }
        .notification-item.danger .title { color: var(--danger); }
        .notification-empty { padding: 32px 16px; text-align: center; color: var(--text-dim); font-size: 13px; }

        /* Loading Modal */
        .loading-modal { display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.45); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(2px); }
        .loading-modal.show { display:flex; }
        .loading-content { background:#fff; padding:36px 40px; border-radius:16px; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.2); min-width:180px; }
        .spinner { width:40px; height:40px; border:3px solid #e5e5e5; border-top-color:var(--accent); border-radius:50%; animation:spin 0.7s linear infinite; margin:0 auto 14px; }
        @@keyframes spin { to { transform:rotate(360deg); } }
        .loading-content p { font-size:14px; font-weight:600; color:var(--text); }

        /* Search Dropdown */
        .search-dropdown { position:absolute; top:100%; left:0; right:0; background:#fff; border:1px solid var(--border); border-radius:var(--radius); box-shadow:var(--shadow-md); z-index:100; max-height:320px; overflow-y:auto; margin-top:4px; }
        .search-dropdown .search-item { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; font-size:13px; border-bottom:1px solid #f3f4f6; cursor:pointer; text-decoration:none; color:var(--text); transition:background 0.1s; }
        .search-dropdown .search-item:hover { background:#f9f9fb; }
        .search-dropdown .search-empty { padding:16px; text-align:center; color:var(--text-dim); font-size:13px; }

        /* Products Grid for Apprentice */
        .products-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:16px; }
        .product-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; transition:box-shadow 0.2s; }
        .product-card:hover { box-shadow:var(--shadow-md); }
        .product-img { width:100%; height:140px; background:#f9f9fb; display:flex; align-items:center; justify-content:center; overflow:hidden; }
        .product-img img { width:100%; height:100%; object-fit:cover; }
        .product-img-placeholder { font-size:36px; color:var(--text-dim); opacity:0.3; }
        .product-info { padding:14px; }
        .product-name { font-size:14px; font-weight:700; margin-bottom:4px; line-height:1.3; }
        .product-price { font-size:16px; font-weight:800; color:var(--primary); margin-bottom:6px; }
        .product-stock { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-bottom:10px; }
        .stock-badge { font-size:11px; font-weight:600; padding:2px 8px; border-radius:12px; }
        .stock-badge.instock { background:#dcfce7; color:#166534; }
        .stock-badge.lowstock { background:#fef3c7; color:#92400e; }
        .stock-badge.outofstock { background:#fee2e2; color:#991b1b; }
        .expiring-label { font-size:11px; color:var(--text-muted); }
        .expiring-label.expired { color:var(--danger); font-weight:600; }
        .expiring-label.expiring-soon { color:var(--warning); font-weight:600; }
        .image-upload-area { border:2px dashed var(--border); border-radius:var(--radius); padding:24px; text-align:center; cursor:pointer; transition:all 0.2s; min-height:140px; display:flex; align-items:center; justify-content:center; flex-direction:column; }
        .image-upload-area:hover { border-color:var(--accent); background:#f9fff0; }

        /* Sidebar footer */
        .sidebar-footer { padding:12px 20px; border-top:1px solid rgba(255,255,255,.08); }
        .sidebar-footer .nav-item { width:100%; color:rgba(255,255,255,.5); font-size:13px; }
        .sidebar-footer .nav-item:hover { color:#fff; background:rgba(255,255,255,.06); }
        .sidebar-user { padding:8px 20px 12px; border-top:1px solid rgba(255,255,255,.08); }
        .sidebar-user-name { font-size:13px; font-weight:600; color:#fff; margin-bottom:2px; }
        .sidebar-user-role { font-size:11px; color:rgba(255,255,255,.4); }

        @@media (max-width: 768px) {
            .notification-panel { width: calc(100vw - 32px); right: -16px; }
            .products-grid { grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/" class="sidebar-logo">
                <span class="logo-icon"><i class="fas fa-store"></i></span>
                <span class="logo-text">PharMarket</span>
            </a>
        </div>
        <nav class="sidebar-nav">
            @if (User.IsInRole("Admin"))
            {
                <a href="/" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="fas fa-th-large"></i><span>Dashboard</span>
                </a>
            }
            else
            {
                <a href="/Apprentice" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Apprentice" ? "active" : "")">
                    <i class="fas fa-th-large"></i><span>Dashboard</span>
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <div class="nav-section">SALES</div>
                <a href="/Sales/POS" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "POS" ? "active" : "")">
                    <i class="fas fa-cash-register"></i><span>POS</span>
                </a>
                <a href="/Sales" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" && ViewContext.RouteData.Values["action"]?.ToString() != "POS" ? "active" : "")">
                    <i class="fas fa-receipt"></i><span>Sales History</span>
                </a>

                <div class="nav-section">INVENTORY</div>
                <a href="/Products" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")">
                    <i class="fas fa-boxes-stacked"></i><span>Products</span>
                </a>
                <a href="/Stock" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" ? "active" : "")">
                    <i class="fas fa-warehouse"></i><span>Stock</span>
                </a>
                <a href="/Purchases" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchases" ? "active" : "")">
                    <i class="fas fa-truck-loading"></i><span>Purchases</span>
                </a>
                <a href="/Suppliers" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "active" : "")">
                    <i class="fas fa-handshake"></i><span>Suppliers</span>
                </a>

                <div class="nav-section">FINANCE</div>
                <a href="/Expenses" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Expenses" ? "active" : "")">
                    <i class="fas fa-money-bill-wave"></i><span>Expenses</span>
                </a>
                <a href="/Transactions" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active" : "")">
                    <i class="fas fa-exchange-alt"></i><span>Transactions</span>
                </a>

                <div class="nav-section">REPORTS</div>
                <a href="/Reports/Sales" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">
                    <i class="fas fa-chart-line"></i><span>Reports</span>
                </a>

                <div class="nav-section">MANAGE</div>
                <a href="/Users" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                    <i class="fas fa-users-cog"></i><span>Users</span>
                </a>
                <a href="/Store/Settings" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Store" ? "active" : "")">
                    <i class="fas fa-cog"></i><span>Store Settings</span>
                </a>
                <a href="/Admin/StaffSales" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                    <i class="fas fa-clipboard-list"></i><span>Staff Sales</span>
                </a>
            }
            else
            {
                <div class="nav-section">MY WORK</div>
                <a href="/Apprentice/MySales" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "MySales" ? "active" : "")">
                    <i class="fas fa-receipt"></i><span>My Sales Today</span>
                </a>
            }

        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-user-name">@User.Identity?.Name</div>
                <div class="sidebar-user-role">@(User.IsInRole("Admin") ? "Admin" : "Staff")</div>
            </div>
            <form asp-action="Logout" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-item" style="width:100%;border:none;background:none;cursor:pointer;text-align:left;">
                    <i class="fas fa-sign-out-alt"></i><span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="main-area">
        <header class="topbar">
            <button class="sidebar-toggle" id="sidebarToggle" onclick="document.getElementById('sidebar').classList.toggle('open')">
                <i class="fas fa-bars"></i>
            </button>
            <div class="topbar-right">
                @if (User.IsInRole("Admin"))
                {
                    <div class="alert-badges">
                        <a href="/Stock/LowStock" class="alert-badge warning" title="Low Stock Alerts">
                            <i class="fas fa-exclamation-triangle"></i>
                        </a>
                        <div class="notification-dropdown">
                            <div class="alert-badge notification-bell" id="notifBell" onclick="toggleNotifications()">
                                <i class="fas fa-bell"></i>
                                @if (ViewBag.UnreadNotificationCount != null && (int)ViewBag.UnreadNotificationCount > 0)
                                {
                                    <span class="notification-badge">@ViewBag.UnreadNotificationCount</span>
                                }
                            </div>
                            <div class="notification-panel" id="notifPanel">
                                <div class="notification-panel-header">
                                    <h4>Notifications</h4>
                                    <button onclick="markAllRead()">Mark all read</button>
                                </div>
                                <div id="notifList">
                                    <div class="notification-empty">Loading...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </header>

        <main class="content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" onclick="this.remove()">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-error" onclick="this.remove()">
                    <i class="fas fa-times-circle"></i> @TempData["ErrorMessage"]
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning" onclick="this.remove()">
                    <i class="fas fa-exclamation-circle"></i> @TempData["WarningMessage"]
                </div>
            }
            @RenderBody()
        </main>
    </div>

    @await Html.PartialAsync("_LoadingModal")

    <script src="~/js/app.js" asp-append-version="true"></script>
    <script>
        function showLoading(text) {
            document.getElementById('loadingText').textContent = text || 'Processing...';
            document.getElementById('loadingModal').classList.add('show');
        }
        function hideLoading() {
            document.getElementById('loadingModal').classList.remove('show');
        }

        document.querySelectorAll('form').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                var btn = form.querySelector('button[type="submit"]');
                var loadingText = btn && btn.dataset.loading ? btn.dataset.loading : 'Processing...';
                if (btn) btn.disabled = true;
                showLoading(loadingText);
            });
        });

        document.querySelectorAll('[data-loading]').forEach(function(el) {
            if (el.tagName !== 'FORM' && el.tagName !== 'BUTTON' && el.tagName !== 'INPUT') {
                el.addEventListener('click', function() {
                    showLoading(this.dataset.loading || 'Loading...');
                });
            }
        });

        function toggleNotifications() {
            var panel = document.getElementById('notifPanel');
            panel.classList.toggle('open');
            if (panel.classList.contains('open') && document.getElementById('notifList').children.length === 0) {
                loadNotifications();
            }
        }

        async function loadNotifications() {
            try {
                var res = await fetch('/Notifications/GetUnread');
                var data = await res.json();
                var list = document.getElementById('notifList');
                if (data.length === 0) {
                    list.innerHTML = '<div class="notification-empty"><i class="fas fa-bell-slash" style="font-size:24px;opacity:.3;margin-bottom:8px;display:block;"></i>No new notifications</div>';
                    return;
                }
                list.innerHTML = data.map(n =>
                    '<div class="notification-item ' + n.type + '" onclick="markRead(' + n.id + ')">' +
                    '<div class="title">' + n.title + '</div>' +
                    '<div class="message">' + n.message + '</div>' +
                    '<div class="time">' + new Date(n.createdAt).toLocaleString() + '</div>' +
                    '</div>'
                ).join('');
            } catch(e) {
                document.getElementById('notifList').innerHTML = '<div class="notification-empty">Failed to load</div>';
            }
        }

        async function markRead(id) {
            await fetch('/Notifications/MarkRead/' + id, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' } });
            loadNotifications();
        }

        async function markAllRead() {
            await fetch('/Notifications/MarkAllRead', { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' } });
            var badge = document.querySelector('.notification-badge');
            if (badge) badge.remove();
            loadNotifications();
        }

        document.addEventListener('click', function(e) {
            var dropdown = document.querySelector('.notification-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                document.getElementById('notifPanel').classList.remove('open');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
