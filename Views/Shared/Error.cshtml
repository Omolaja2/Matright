@model PharMarket.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - PharMarket</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root{--primary:#111;--primary-light:#333;--accent:#D4FF00;--accent-hover:#c2eb00;--bg:#f5f5f7;--surface:#fff;--border:#e5e5e5;--text:#111;--text-muted:#666;--text-dim:#999;--success:#16a34a;--warning:#d97706;--danger:#dc2626;--info:#2563eb;--radius:10px;--radius-sm:6px;--shadow:0 1px 3px rgba(0,0,0,.06);--shadow-md:0 4px 12px rgba(0,0,0,.08)}
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
        html{-webkit-font-smoothing:antialiased}
        body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center}
        .error-wrap{max-width:480px;width:100%}
        .error-icon{width:80px;height:80px;border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:32px}
        .error-icon.server{background:#fee2e2;color:var(--danger)}
        .error-icon.not-found{background:#dbeafe;color:var(--info)}
        .error-icon.bad{background:#fef3c7;color:var(--warning)}
        .error-code{font-size:clamp(56px,12vw,96px);font-weight:900;letter-spacing:-0.04em;line-height:1;margin-bottom:8px}
        .error-title{font-size:clamp(20px,4vw,28px);font-weight:700;letter-spacing:-0.02em;margin-bottom:8px}
        .error-message{font-size:15px;color:var(--text-muted);max-width:400px;margin:0 auto 32px;line-height:1.6}
        .error-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
        .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;border:1px solid transparent;cursor:pointer;transition:all .15s;text-decoration:none}
        .btn-primary{background:var(--primary);color:#fff;border-color:var(--primary)}
        .btn-primary:hover{background:var(--primary-light)}
        .btn-outline{background:transparent;color:var(--text);border-color:var(--border)}
        .btn-outline:hover{border-color:var(--text);background:#fff}
        .error-id{font-size:11px;color:var(--text-dim);margin-top:24px;font-family:monospace}
        .error-illustration{font-size:64px;margin-bottom:16px;opacity:0.15}
    </style>
</head>
<body>
    <div class="error-wrap">
        @{
            var code = Model?.StatusCode ?? 500;
            var iconClass = code == 404 ? "fas fa-compass" : code >= 500 ? "fas fa-server" : "fas fa-exclamation-triangle";
            var iconBg = code == 404 ? "not-found" : code >= 500 ? "server" : "bad";
            var title = code switch
            {
                404 => "Page Not Found",
                403 => "Access Denied",
                401 => "Unauthorized",
                400 => "Bad Request",
                _ => "Something went wrong"
            };
            var friendlyMessage = code switch
            {
                404 => "The page you're looking for doesn't exist or may have been moved.",
                403 => "You don't have permission to access this page.",
                401 => "Please log in to continue.",
                400 => "The request could not be understood. Please check your input.",
                500 => "Our server ran into an issue. Please try again in a moment.",
                _ => "An unexpected error occurred. Please try again later."
            };
        }

        <div class="error-icon @iconBg">
            <i class="@iconClass"></i>
        </div>
        <div class="error-code">@code</div>
        <h1 class="error-title">@(Model?.Message ?? title)</h1>
        <p class="error-message">@friendlyMessage</p>
        <div class="error-actions">
            <a href="/" class="btn btn-primary">
                <i class="fas fa-home"></i> Back to Home
            </a>
            <button onclick="history.back()" class="btn btn-outline">
                <i class="fas fa-arrow-left"></i> Go Back
            </button>
        </div>
        @if (Model?.ShowRequestId ?? false)
        {
            <div class="error-id">Request ID: @Model.RequestId</div>
        }
    </div>
</body>
</html>
