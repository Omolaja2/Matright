@model PharMarket.Helpers.PaginationInfo

@if (Model.TotalPages > 1)
{
    <div class="card-footer">
        <div class="pagination">
            @if (Model.CurrentPage > 1)
            {
                var prevValues = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = (Model.CurrentPage - 1).ToString() };
                <a asp-action="@Model.Action" asp-controller="@Model.Controller" asp-all-route-data="prevValues">
                    <i class="fas fa-chevron-left"></i>
                </a>
            }

            @{
                int start = Math.Max(1, Model.CurrentPage - 2);
                int end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                if (start > 1)
                {
                    var firstValues = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = "1" };
                    <a asp-action="@Model.Action" asp-controller="@Model.Controller" asp-all-route-data="firstValues">1</a>
                    if (start > 2)
                    {
                        <span style="min-width:24px;text-align:center;color:var(--text-dim);">...</span>
                    }
                }

                for (var i = start; i <= end; i++)
                {
                    var values = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = i.ToString() };
                    <a asp-action="@Model.Action" asp-controller="@Model.Controller" asp-all-route-data="values" class="@(i == Model.CurrentPage ? "active" : "")">@i</a>
                }

                if (end < Model.TotalPages)
                {
                    if (end < Model.TotalPages - 1)
                    {
                        <span style="min-width:24px;text-align:center;color:var(--text-dim);">...</span>
                    }
                    var lastValues = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = Model.TotalPages.ToString() };
                    <a asp-action="@Model.Action" asp-controller="@Model.Controller" asp-all-route-data="lastValues">@Model.TotalPages</a>
                }
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                var nextValues = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = (Model.CurrentPage + 1).ToString() };
                <a asp-action="@Model.Action" asp-controller="@Model.Controller" asp-all-route-data="nextValues">
                    <i class="fas fa-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}
