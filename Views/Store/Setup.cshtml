@model PharMarket.ViewModels.Store.StoreViewModel
@{
    Layout = null;
    ViewData["Title"] = "Set Up Your Store";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set Up Your Store - PharMarket</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: var(--bg);
            padding: 20px;
        }
        .setup-card {
            width: 100%;
            max-width: 520px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            overflow: hidden;
        }
        .setup-header {
            padding: 32px 32px 0;
            text-align: center;
        }
        .setup-header .logo-icon {
            width: 48px;
            height: 48px;
            background: var(--accent);
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--primary);
            margin-bottom: 16px;
        }
        .setup-header h1 {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 8px;
        }
        .setup-header p {
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.5;
        }
        .setup-body {
            padding: 24px 32px 32px;
        }
        .setup-body .form-group {
            margin-bottom: 16px;
        }
        .setup-body .form-group label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
        }
        .setup-body .form-control {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.15s, box-shadow 0.15s;
            background: #fff;
        }
        .setup-body .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(17,17,17,.06);
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .text-danger {
            color: var(--danger);
            font-size: 12px;
            margin-top: 4px;
        }
        .btn-setup {
            width: 100%;
            padding: 14px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 8px;
            transition: background 0.15s;
        }
        .btn-setup:hover { background: var(--primary-light); }
        .field-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: var(--bg);
            border-radius: 8px;
            font-size: 14px;
            color: var(--text-muted);
            flex-shrink: 0;
        }
        .field-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .field-row .form-control { flex: 1; }
        .validation-summary {
            background: #fee2e2;
            color: #991b1b;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
        }
        .validation-summary ul { margin: 4px 0 0 16px; padding: 0; }
        @@media (max-width: 480px) {
            .setup-card { border-radius: 12px; }
            .setup-header { padding: 24px 20px 0; }
            .setup-body { padding: 20px; }
            .form-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="setup-card">
        <div class="setup-header">
            <div class="logo-icon">🏪</div>
            <h1>Set Up Your Store</h1>
            <p>Tell us about your business to get started. This takes less than a minute.</p>
        </div>
        <div class="setup-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    <strong>Please fix the following:</strong>
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="Setup" asp-controller="Store" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Name">Store / Business Name</label>
                    <div class="field-row">
                        <span class="field-icon">🏪</span>
                        <input asp-for="Name" class="form-control" placeholder="e.g. John's Electronics" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Address">Business Address</label>
                    <div class="field-row">
                        <span class="field-icon">📍</span>
                        <input asp-for="Address" class="form-control" placeholder="e.g. 123 Main Street, Lagos" />
                    </div>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="OwnerName">Owner / CEO Name</label>
                        <input asp-for="OwnerName" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="OwnerName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OwnerPosition">Position / Title</label>
                        <input asp-for="OwnerPosition" class="form-control" placeholder="e.g. CEO" />
                        <span asp-validation-for="OwnerPosition" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Phone">Phone Number</label>
                        <div class="field-row">
                            <span class="field-icon">📞</span>
                            <input asp-for="Phone" class="form-control" placeholder="e.g. 08012345678" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email">Business Email</label>
                        <div class="field-row">
                            <span class="field-icon">✉️</span>
                            <input asp-for="Email" class="form-control" placeholder="e.g. info@business.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Description">What does your business sell? (optional)</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="e.g. Electronics, groceries, pharmaceuticals, etc."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-setup">
                    Create Store & Go to Dashboard
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="vertical-align: middle; margin-left: 4px;"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </form>
        </div>
    </div>

    <div id="loadingModal" class="loading-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.45);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(2px);">
        <div style="background:#fff;padding:36px 40px;border-radius:16px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.2);min-width:180px;">
            <div style="width:40px;height:40px;border:3px solid #e5e5e5;border-top-color:var(--primary);border-radius:50%;animation:spin 0.7s linear infinite;margin:0 auto 14px;"></div>
            <p id="loadingText" style="font-size:14px;font-weight:600;color:var(--text);">Setting up...</p>
        </div>
    </div>
    <script>
        document.querySelectorAll('form').forEach(function(f){f.addEventListener('submit',function(){var b=f.querySelector('button[type=submit]');if(b)b.disabled=true;var m=document.getElementById('loadingModal');m.style.display='flex';document.getElementById('loadingText').textContent='Setting up...'})});
    </script>
</body>
</html>
