@model List<Supplier>
@using PharMarket.Helpers
@{
    ViewData["Title"] = "Suppliers";
}
<div class="page-header">
    <div>
        <h1>Suppliers</h1>
        <p>Manage your product suppliers</p>
    </div>
    <div class="btn-group">
        <a asp-action="Create" asp-controller="Suppliers" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Supplier
        </a>
    </div>
</div>
<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="empty-state" style="padding:32px;">No suppliers found.</td></tr>
                }
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-controller="Suppliers" asp-route-id="@supplier.Id" style="font-weight:600;">@supplier.Name</a></td>
                        <td>@supplier.ContactPerson</td>
                        <td>@supplier.Phone</td>
                        <td>@supplier.Email</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-controller="Suppliers" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline">
                                    <i class="fas fa-pen"></i> Edit
                                </a>
                                <a asp-action="Details" asp-controller="Suppliers" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline">
                                    <i class="fas fa-eye"></i> View
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
