@model SupplierViewModel
@{
    ViewData["Title"] = "Add Supplier";
}
<div class="page-header">
    <div>
        <h1>Add Supplier</h1>
        <p>Register a new supplier</p>
    </div>
    <div class="btn-group">
        <a asp-action="Index" asp-controller="Suppliers" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Back to Suppliers
        </a>
    </div>
</div>
<form asp-action="Create" asp-controller="Suppliers" method="post">
    <div class="card">
        <div class="card-header"><h3>Supplier Details</h3></div>
        <div class="card-body">
            <div class="form-group">
                <label asp-for="Name"><span class="required">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Enter supplier name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ContactPerson"></label>
                    <input asp-for="ContactPerson" class="form-control" placeholder="Enter contact person" />
                </div>
                <div class="form-group">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address"></label>
                <textarea asp-for="Address" class="form-control" placeholder="Enter supplier address" rows="3"></textarea>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Save Supplier
            </button>
            <a asp-action="Index" asp-controller="Suppliers" class="btn btn-outline">Cancel</a>
        </div>
    </div>
</form>
