@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="page-header">
    <div>
        <h1>Products</h1>
        <p>Manage your product catalog and inventory.</p>
    </div>
    <a asp-action="Create" class="btn btn-accent">
        <i class="fas fa-plus"></i> Add Product
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="filters-bar">
                <input type="text" asp-for="SearchQuery" class="form-control" placeholder="Search products..." />
                <select asp-for="CategoryFilter" asp-items="@(new SelectList(ViewBag.Categories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text"))" class="form-control">
                    <option value="">All Categories</option>
                </select>
                <select asp-for="SupplierFilter" asp-items="@(new SelectList(ViewBag.Suppliers as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text"))" class="form-control">
                    <option value="">All Suppliers</option>
                </select>
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-search"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-outline btn-sm">
                    <i class="fas fa-times"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card" style="margin-top: 16px;">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Cost Price</th>
                    <th>Sales Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Any())
                {
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <strong>@product.Name</strong>
                                @if (!string.IsNullOrEmpty(product.Barcode))
                                {
                                    <br />
                                    <small style="color: var(--text-dim);">@product.Barcode</small>
                                }
                            </td>
                            <td>@product.CategoryName</td>
                            <td>@CurrencyHelper.FormatCurrency(product.CostPrice)</td>
                            <td>@CurrencyHelper.FormatCurrency(product.SalesPrice)</td>
                            <td>
                                @if (product.TotalStock <= 0)
                                {
                                    <span class="badge badge-danger">Out of Stock</span>
                                }
                                else if (product.TotalStock <= 10)
                                {
                                    <span class="badge badge-warning">@product.TotalStock</span>
                                }
                                else
                                {
                                    <span>@product.TotalStock</span>
                                }
                            </td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-neutral">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline btn-sm" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline btn-sm" title="Edit">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fas fa-boxes-stacked"></i>
                                <h3>No products found</h3>
                                <p>Add your first product to get started.</p>
                                <a asp-action="Create" class="btn btn-accent">
                                    <i class="fas fa-plus"></i> Add Product
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer">
            <div class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryFilter="@Model.CategoryFilter"
                       asp-route-supplierFilter="@Model.SupplierFilter">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                }

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryFilter="@Model.CategoryFilter"
                       asp-route-supplierFilter="@Model.SupplierFilter"
                       class="@(i == Model.CurrentPage ? "active" : "")">@i</a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryFilter="@Model.CategoryFilter"
                       asp-route-supplierFilter="@Model.SupplierFilter">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>
