@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="page-header">
    <div>
        <h1>Products</h1>
        <p>Manage your product catalog.</p>
    </div>
    <a asp-action="Create" class="btn btn-accent">
        <i class="fas fa-plus"></i> Add Product
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="filters-bar">
                <div style="position:relative;flex:1;max-width:320px;">
                    <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-dim);font-size:13px;"></i>
                    <input type="text" asp-for="SearchQuery" class="form-control" style="padding-left:36px;" placeholder="Search products..." id="adminSearch" autocomplete="off" />
                    <div id="adminSearchDropdown" class="search-dropdown" style="display:none;"></div>
                </div>
                <select asp-for="CategoryFilter" asp-items="@(new SelectList(ViewBag.Categories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text"))" class="form-control">
                    <option value="">All Categories</option>
                </select>
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-search"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-outline btn-sm">
                    <i class="fas fa-times"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card" style="margin-top: 16px;">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Expiry</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Any())
                {
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td><strong>@product.Name</strong></td>
                            <td>@product.CategoryName</td>
                            <td>@CurrencyHelper.FormatCurrency(product.SalesPrice)</td>
                            <td>
                                @if (product.TotalStock <= 0)
                                {
                                    <span class="badge badge-danger">Out of Stock</span>
                                }
                                else if (product.TotalStock <= 10)
                                {
                                    <span class="badge badge-warning">@product.TotalStock left</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">@product.TotalStock</span>
                                }
                            </td>
                            <td>
                                @if (product.ExpirationDate.HasValue)
                                {
                                    var exp = product.ExpirationDate.Value;
                                    var isExpired = exp < DateTime.UtcNow;
                                    var isSoon = exp <= DateTime.UtcNow.AddDays(30);
                                    <span class="badge @(isExpired ? "badge-danger" : isSoon ? "badge-warning" : "badge-neutral")">
                                        @exp.ToString("dd MMM yy")
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-dim);">-</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline btn-sm" title="Edit">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="fas fa-boxes-stacked"></i>
                                <h3>No products found</h3>
                                <p>Add your first product to get started.</p>
                                <a asp-action="Create" class="btn btn-accent">
                                    <i class="fas fa-plus"></i> Add Product
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer">
            <div class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryFilter="@Model.CategoryFilter">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                }

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryFilter="@Model.CategoryFilter"
                       class="@(i == Model.CurrentPage ? "active" : "")">@i</a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryFilter="@Model.CategoryFilter">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
var adminSearchTimeout;
document.getElementById('adminSearch').addEventListener('input', function() {
    var val = this.value.trim();
    clearTimeout(adminSearchTimeout);
    if (val.length < 1) { document.getElementById('adminSearchDropdown').style.display = 'none'; return; }
    adminSearchTimeout = setTimeout(async function() {
        try {
            var res = await fetch('/Products/Search?q=' + encodeURIComponent(val));
            var data = await res.json();
            var dd = document.getElementById('adminSearchDropdown');
            if (data.length === 0) {
                dd.innerHTML = '<div class="search-empty">No results</div>';
            } else {
                dd.innerHTML = data.map(function(p) {
                    var sc = p.stockTotal <= 0 ? 'badge-danger' : p.stockTotal <= 10 ? 'badge-warning' : 'badge-success';
                    return '<a href="/Products?search=' + encodeURIComponent(val) + '" class="search-item">' +
                        '<strong>' + p.name + '</strong> ' +
                        '<span class="' + sc + '" style="font-size:11px;">' + p.stockTotal + ' in stock</span>' +
                    '</a>';
                }).join('');
            }
            dd.style.display = 'block';
        } catch(e) {}
    }, 250);
});
document.getElementById('adminSearch').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); window.location.href = '/Products?search=' + encodeURIComponent(this.value.trim()); }
});
document.addEventListener('click', function(e) {
    if (!e.target.closest('#adminSearch') && !e.target.closest('#adminSearchDropdown'))
        document.getElementById('adminSearchDropdown').style.display = 'none';
});
</script>
}
