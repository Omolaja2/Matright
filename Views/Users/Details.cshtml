@model PharMarket.ViewModels.Users.UserListItem
@{
    ViewData["Title"] = "User Details";
}

<div class="page-header">
    <div>
        <h1>User Details</h1>
        <p>View account information for @Model.FullName</p>
    </div>
    <a href="/Users" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back to Users
    </a>
</div>

<div class="card" style="max-width:560px">
    <div class="card-body">
        <div class="detail-row">
            <span class="detail-label">Full Name</span>
            <span class="detail-value"><strong>@Model.FullName</strong></span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value">@Model.Email</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Password</span>
            <span class="detail-value">
                <span class="pw-value" id="pw-@Model.Id">••••••••••</span>
                <button type="button" class="btn btn-sm btn-link pw-toggle" onclick="togglePassword(@Model.Id, this)" title="Show/Hide Password">
                    <i class="fas fa-eye"></i>
                </button>
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Role</span>
            <span class="detail-value">
                <span class="badge @(Model.Role == "Admin" ? "badge-info" : "badge-neutral")">
                    @Model.Role
                </span>
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Position</span>
            <span class="detail-value">@(Model.Position ?? "Not assigned")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Status</span>
            <span class="detail-value">
                <span class="badge @(Model.IsActive ? "badge-success" : "badge-danger")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Created</span>
            <span class="detail-value">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Last Login</span>
            <span class="detail-value">@(Model.LastLoginAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</span>
        </div>
    </div>
</div>

<div style="max-width:560px;margin-top:20px">
    <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline" onclick="return confirm('Generate a new password for @Model.FullName? The new password will be shown on screen and emailed to them.')">
            <i class="fas fa-key"></i> Reset Password
        </button>
    </form>
</div>

<style>
    .detail-row { display: flex; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--border); }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { width: 140px; flex-shrink: 0; font-size: 13px; color: var(--text-muted); font-weight: 500; }
    .detail-value { font-size: 14px; color: var(--text); }
    .pw-toggle { padding: 0 4px; color: var(--text-muted); }
    .pw-toggle:hover { color: var(--text); }
</style>

@section Scripts {
    <script>
        async function togglePassword(id, btn) {
            var span = document.getElementById('pw-' + id);
            var icon = btn.querySelector('i');

            if (span.dataset.revealed === 'true') {
                span.textContent = '••••••••••';
                span.dataset.revealed = 'false';
                icon.className = 'fas fa-eye';
                return;
            }

            var res = await fetch('/Users/RevealPassword/' + id);
            var data = await res.json();

            if (data.success) {
                span.textContent = data.password;
                span.dataset.revealed = 'true';
                icon.className = 'fas fa-eye-slash';
            } else {
                span.textContent = data.message;
            }
        }
    </script>
}
