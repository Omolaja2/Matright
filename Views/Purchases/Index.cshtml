@using PharMarket.Helpers
@model List<PharMarket.Models.Entities.Purchase>

@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="page-header">
    <div>
        <h1>Purchase Orders</h1>
        <p>Manage purchase orders from suppliers</p>
    </div>
    <a asp-action="Create" class="btn btn-accent"><i class="fas fa-plus"></i> New Purchase</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Supplier</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <i class="fas fa-truck-loading" style="font-size:24px;opacity:1"></i>
                                <h3>No purchase orders</h3>
                                <p>Create your first purchase order to get started.</p>
                                <a asp-action="Create" class="btn btn-accent"><i class="fas fa-plus"></i> New Purchase</a>
                            </td>
                        </tr>
                    }
                    @foreach (var purchase in Model)
                    {
                        <tr>
                            <td><strong>@purchase.OrderNumber</strong></td>
                            <td>@purchase.Supplier?.Name</td>
                            <td>@CurrencyHelper.FormatDate(purchase.PurchaseDate)</td>
                            <td>@CurrencyHelper.FormatCurrency(purchase.TotalAmount)</td>
                            <td>
                                @switch (purchase.Status)
                                {
                                    case PharMarket.Models.Enums.PurchaseStatus.Pending:
                                        <span class="badge badge-warning">Pending</span>
                                        break;
                                    case PharMarket.Models.Enums.PurchaseStatus.Received:
                                        <span class="badge badge-success">Received</span>
                                        break;
                                    case PharMarket.Models.Enums.PurchaseStatus.Cancelled:
                                        <span class="badge badge-danger">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@purchase.Id" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i> View</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Pagination", new PharMarket.Helpers.PaginationInfo
{
    CurrentPage = (int)(ViewBag.Page ?? 1),
    TotalPages = (int)(ViewBag.TotalPages ?? 1),
    Action = "Index",
    Controller = "Purchases"
})
