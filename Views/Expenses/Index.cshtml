@model List<PharMarket.Models.Entities.Expense>

@{
    ViewData["Title"] = "Expenses";
}

<div class="page-header">
    <div>
        <h1>Expenses</h1>
        <p>Track and manage business expenses</p>
    </div>
    <a asp-action="Create" class="btn btn-accent"><i class="fas fa-plus"></i> Add Expense</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="filters-bar">
            <input type="date" name="startDate" class="form-control" value="@Context.Request.Query["startDate"]" placeholder="Start Date" />
            <input type="date" name="endDate" class="form-control" value="@Context.Request.Query["endDate"]" placeholder="End Date" />
            <select name="category" class="form-control">
                <option value="">All Categories</option>
                @foreach (var cat in (string[])ViewBag.Categories)
                {
                    <option value="@cat" selected="@(Context.Request.Query["category"] == cat)">@cat</option>
                }
            </select>
            <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline"><i class="fas fa-times"></i> Clear</a>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <i class="fas fa-money-bill-wave" style="font-size:24px;opacity:1"></i>
                                <h3>No expenses recorded</h3>
                                <p>Record your first expense to get started.</p>
                                <a asp-action="Create" class="btn btn-accent"><i class="fas fa-plus"></i> Add Expense</a>
                            </td>
                        </tr>
                    }
                    @foreach (var expense in Model)
                    {
                        <tr>
                            <td>@CurrencyHelper.FormatDate(expense.ExpenseDate)</td>
                            <td>@expense.Description</td>
                            <td><span class="badge badge-neutral">@expense.Category</span></td>
                            <td><strong>@CurrencyHelper.FormatCurrency(expense.Amount)</strong></td>
                            <td>@expense.PaymentMethod</td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@expense.Id" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" asp-route-id="@expense.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this expense?')">
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Pagination", new PharMarket.Helpers.PaginationInfo
{
    CurrentPage = (int)(ViewBag.Page ?? 1),
    TotalPages = (int)(ViewBag.TotalPages ?? 1),
    Action = "Index",
    Controller = "Expenses",
    RouteValues = new Dictionary<string, string?>
    {
        ["startDate"] = Context.Request.Query["startDate"].FirstOrDefault(),
        ["endDate"] = Context.Request.Query["endDate"].FirstOrDefault(),
        ["category"] = Context.Request.Query["category"].FirstOrDefault()
    }
})
